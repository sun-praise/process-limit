<Window x:Class="ProcessLimit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProcessLimit - 进程内存限制工具" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#C0C0C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="DangerBtn" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#D13438"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A4262C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="SuccessBtn" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#107C10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B6A0B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="进程内存限制工具" FontSize="22" FontWeight="Bold" Foreground="#1B1B1B"/>
            <TextBlock Text="通过 Windows Job Object 限制指定进程的最大内存使用量" FontSize="13" Foreground="#666" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content: Processes + Rules -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Process List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,8,0"
                             ToolTip="搜索进程名称"/>
                    <Button Grid.Column="1" Content="刷新列表" Command="{Binding RefreshCommand}" Style="{StaticResource ActionBtn}"/>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                          BorderThickness="1" BorderBrush="#DDD" Background="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="进程名称" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#CCC"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLimited}" Value="True">
                                                                <Setter Property="Fill" Value="#0078D4"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="实例数" Width="70" DisplayMemberBinding="{Binding InstanceCount}"/>
                            <GridViewColumn Header="内存占用" Width="120" DisplayMemberBinding="{Binding MemoryDisplay}"/>
                            <GridViewColumn Header="限制状态" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="未限制"/>
                                                    <Setter Property="Foreground" Value="#999"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLimited}" Value="True">
                                                            <Setter Property="Text" Value="已限制"/>
                                                            <Setter Property="Foreground" Value="#0078D4"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="限制上限" Width="100" DisplayMemberBinding="{Binding Rule.MaxMemoryDisplay}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Rules Panel -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="限制规则" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <ListView Grid.Row="1" ItemsSource="{Binding Rules}" BorderThickness="1" BorderBrush="#DDD" Background="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="进程" Width="130" DisplayMemberBinding="{Binding ProcessName}"/>
                            <GridViewColumn Header="内存上限" Width="100" DisplayMemberBinding="{Binding MaxMemoryDisplay}"/>
                            <GridViewColumn Header="状态" Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="关"/>
                                                    <Setter Property="Foreground" Value="#D13438"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Text" Value="开"/>
                                                            <Setter Property="Foreground" Value="#107C10"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="启用/禁用" Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="删除规则" Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>

                <!-- Add Rule -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock Text="添加规则" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewRuleProcessName}" Padding="6,4" Margin="0,0,4,0"
                                 ToolTip="进程名称（不含.exe）"/>
                        <TextBox Grid.Column="1" Text="{Binding NewRuleMemoryMB}" Padding="6,4"
                                 ToolTip="内存上限 (MB)"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MB" Foreground="#999" VerticalAlignment="Center" FontSize="11"/>
                        <Button Grid.Column="1" Content="从选中进程" Command="{Binding ApplyToSelectedCommand}" Style="{StaticResource ActionBtn}"
                                Padding="8,4" Margin="0,0,4,0" FontSize="12"/>
                        <Button Grid.Column="2" Content="添加" Command="{Binding AddRuleCommand}" Style="{StaticResource SuccessBtn}"
                                Padding="16,4" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Memory Size Presets -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8">
            <TextBlock Text="快速设置内存上限：" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
            <Button Content="256 MB" Click="SetMemoryPreset" Tag="256" Style="{StaticResource ActionBtn}" Padding="8,3" FontSize="11"/>
            <Button Content="512 MB" Click="SetMemoryPreset" Tag="512" Style="{StaticResource ActionBtn}" Padding="8,3" FontSize="11"/>
            <Button Content="1 GB" Click="SetMemoryPreset" Tag="1024" Style="{StaticResource ActionBtn}" Padding="8,3" FontSize="11"/>
            <Button Content="2 GB" Click="SetMemoryPreset" Tag="2048" Style="{StaticResource ActionBtn}" Padding="8,3" FontSize="11"/>
            <Button Content="4 GB" Click="SetMemoryPreset" Tag="4096" Style="{StaticResource ActionBtn}" Padding="8,3" FontSize="11"/>
            <Button Content="8 GB" Click="SetMemoryPreset" Tag="8192" Style="{StaticResource ActionBtn}" Padding="8,3" FontSize="11"/>
        </StackPanel>

        <GridSplitter Grid.Row="2" VerticalAlignment="Bottom" Height="1" Background="#DDD" Margin="0,0,0,-1"/>

        <!-- Log Panel -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="日志" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Grid.Row="1" Text="{Binding LogText}" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="12" Background="#1E1E1E" Foreground="#D4D4D4"
                     Padding="8" BorderThickness="1" BorderBrush="#DDD"/>
        </Grid>
    </Grid>
</Window>
